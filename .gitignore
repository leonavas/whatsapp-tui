/target

# Local environment values; only sanitized examples belong in Git.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template
.dev.vars
.dev.vars.*
!.dev.vars.example
!.dev.vars.sample
!.dev.vars.template
!.dev.vars.*.example
!.dev.vars.*.sample
!.dev.vars.*.template

# Local credentials and private key material.
.secrets/
secrets.local.*
credentials.local.*
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519

# Local databases can contain account sessions and private messages.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
